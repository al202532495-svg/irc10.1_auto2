# -----------------------------------------------------------------------------
# Configuración del laboratorio Floci
# -----------------------------------------------------------------------------

# Interfaz donde se publican los puertos.
#   127.0.0.1  -> solo accesible desde la propia VM (recomendado; usa túnel SSH)
#   0.0.0.0    -> accesible desde la red. ¡No lo hagas en una red no confiable!
#                 Floci no tiene autenticación y controla el Docker del host.
BIND_ADDR=127.0.0.1

# Versiones de imagen. "latest" para probar; fija una versión (x.y.z) para
# que la demo sea reproducible.
FLOCI_AWS_TAG=latest
FLOCI_AZ_TAG=latest
FLOCI_GCP_TAG=latest
FLOCI_OCI_TAG=latest

# Modo de almacenamiento: memory | persistent | hybrid | wal
#   memory -> cada reinicio deja la nube limpia (ideal para demos repetibles)
#   hybrid -> conserva el estado entre reinicios
STORAGE_MODE=hybrid
